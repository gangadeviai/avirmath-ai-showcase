{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVIRMATH lesson",
  "type": "object",
  "required": ["id", "title", "version", "mathcore", "one_idea", "analogy", "voice", "colors", "equations", "chapters"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "mathcore": {"type": "string"},
    "one_idea": {"type": "string"},
    "audience": {"type": "object"},
    "analogy": {
      "type": "object",
      "required": ["name", "mapping", "breaks_when"],
      "properties": {
        "name": {"type": "string"},
        "mapping": {"type": "object", "additionalProperties": {"type": "string"}},
        "breaks_when": {"type": "string"}
      }
    },
    "voice": {
      "type": "object",
      "required": ["engine", "name"],
      "properties": {"engine": {"type": "string"}, "name": {"type": "string"}, "rate": {"type": "string"}}
    },
    "colors": {"type": "object", "additionalProperties": {"type": "string"}},
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tex", "checked_by"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "tex": {"type": "string"},
          "spoken": {"type": "string"},
          "checked_by": {"type": "string", "pattern": "^test_"}
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "scene", "beats"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "scene": {"type": "string"},
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "cue", "narration"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "cue": {"type": "string"},
                "narration": {"type": "string"},
                "equations": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "seo": {"type": "object"},
    "experiments": {"type": "array"},
    "quiz": {"type": "array"}
  }
}
